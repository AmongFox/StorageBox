# ==========================================
# StorageBox — Пример конфигурации (.env)
# ==========================================
# Скопируйте этот файл в .env и измените значения под вашу среду
# cp .env.example .env

# ==========================================
# БАЗА ДАННЫХ PostgreSQL
# ==========================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=StorageBox
POSTGRES_USER=postgres
POSTGRES_PASSWORD=ваш_пароль

# ==========================================
# ПУЛ СОЕДИНЕНИЙ БД
# ==========================================
# Размер пула соединений (рекомендуется: 5-20)
DB_POOL_SIZE=10

# Максимальное количество дополнительных соединений сверх pool_size
DB_MAX_OVERFLOW=20

# Время (в секундах) после которого соединение пересоздаётся (3600 = 1 час)
DB_POOL_RECYCLE=3600

# Таймаут ожидания свободного соединения из пула (секунды)
DB_POOL_TIMEOUT=30

# Таймаут команды PostgreSQL (секунды)
DB_COMMAND_TIMEOUT=60

# Таймаут выполнения SQL-запроса (миллисекунды, 30000 = 30 сек)
DB_STATEMENT_TIMEOUT=30000

# Таймаут блокировки БД (миллисекунды, 10000 = 10 сек)
DB_LOCK_TIMEOUT=10000

# Логирование SQL-запросов (true/false) — только для отладки!
DB_ECHO=false

# Имя приложения для идентификации в PostgreSQL
DB_APPLICATION_NAME=storagebox

# ==========================================
# UVICORN (веб-сервер)
# ==========================================
# Порт для прослушивания
UVICORN_PORT=8001

# Адрес для прослушивания (0.0.0.0 — все интерфейсы, 127.0.0.1 — только локально)
UVICORN_HOST=0.0.0.0

# Автоматическая перезагрузка при изменении кода (true для разработки, false для production)
UVICORN_RELOAD=false

# ==========================================
# ХРАНИЛИЩЕ ФАЙЛОВ
# ==========================================
# Тип хранилища (пока поддерживается только "local")
STORAGE_TYPE=local

# Путь к хранилищу (абсолютный или относительный)
# STORAGE_PATH=/var/data/storagebox/storage
STORAGE_PATH=./storage

# ==========================================
# ЛИМИТЫ ФАЙЛОВ (в МБ)
# ==========================================
# Максимальный размер любого файла
MAX_FILE_SIZE_MB=250

# Максимальный размер документов
MAX_DOCUMENT_SIZE_MB=250

# Максимальный размер архивов
MAX_ARCHIVE_SIZE_MB=250

# Максимальный размер изображений
MAX_IMAGE_SIZE_MB=250

# Максимальный размер видео
MAX_VIDEO_SIZE_MB=250

# Максимальный размер аудио
MAX_AUDIO_SIZE_MB=250

# ==========================================
# ЛИМИТЫ ПОЛЬЗОВАТЕЛЯ
# ==========================================
# Максимальный общий размер хранилища на пользователя (МБ)
MAX_TOTAL_SIZE_FOR_USER_MB=1024

# ==========================================
# ЛОГИРОВАНИЕ
# ==========================================
# Уровень логирования: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOGGER_LEVEL=INFO

# Список «шумных» логгеров, которые будут заглушены до WARNING (через запятую)
# Пример: python_multipart,sqlalchemy.engine,uvicorn.access
NOISY_LOGGERS=python_multipart
